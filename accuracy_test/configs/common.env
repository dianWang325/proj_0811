#!/usr/bin/env bash

# Shared defaults for accuracy testing. Existing exported values win.
: "${ACCURACY_HOST:=127.0.0.1}"
: "${ACCURACY_PORT:=18080}"
: "${ACCURACY_NPU_DEVICES:=8,9,10,11,12,13,14,15}"
: "${ACCURACY_CPP_ENABLED:=1}"
: "${ACCURACY_RUNNER:=mrv2}"
: "${ACCURACY_MAX_MODEL_LEN:=8192}"
: "${ACCURACY_MAX_NUM_BATCHED_TOKENS:=8192}"
: "${ACCURACY_MAX_NUM_SEQS:=4}"
: "${ACCURACY_MAX_OUT_LEN:=4096}"
: "${ACCURACY_BATCH_SIZE:=4}"
: "${ACCURACY_REQUEST_RATE:=0}"
: "${ACCURACY_TEMPERATURE:=0}"
: "${ACCURACY_REPETITION_PENALTY:=1}"
: "${ACCURACY_GPU_MEMORY_UTILIZATION:=0.90}"
: "${ACCURACY_ENABLE_EXPERT_PARALLEL:=0}"
: "${ACCURACY_CPP_SMOOTH_FACTOR:=0.8}"
: "${ACCURACY_CPP_NEED_TIMING:=true}"
: "${ACCURACY_STARTUP_TIMEOUT:=3600}"
: "${ACCURACY_HCCL_PORT_RANGE:=17000-17100}"

export ACCURACY_HOST ACCURACY_PORT ACCURACY_NPU_DEVICES
export ACCURACY_CPP_ENABLED ACCURACY_RUNNER
export ACCURACY_MAX_MODEL_LEN ACCURACY_MAX_NUM_BATCHED_TOKENS
export ACCURACY_MAX_NUM_SEQS ACCURACY_MAX_OUT_LEN ACCURACY_BATCH_SIZE
export ACCURACY_REQUEST_RATE ACCURACY_TEMPERATURE
export ACCURACY_REPETITION_PENALTY ACCURACY_GPU_MEMORY_UTILIZATION
export ACCURACY_ENABLE_EXPERT_PARALLEL ACCURACY_CPP_SMOOTH_FACTOR
export ACCURACY_CPP_NEED_TIMING ACCURACY_STARTUP_TIMEOUT
export ACCURACY_HCCL_PORT_RANGE
