#!/usr/bin/env bash

# Keep the model identity and topology aligned with the performance configuration.
# The accuracy container exposes the shared weight root at /mnt/weight.
: "${ACCURACY_MODEL_ID:=deepseek-v4-flash-w4a8}"
: "${ACCURACY_MODEL_PATH:=/mnt/weight/DeepSeek-V4-Flash-w4a8}"
: "${ACCURACY_FALLBACK_MODEL_PATH:=}"
: "${ACCURACY_SERVED_MODEL_NAME:=deepseek-v4-flash}"
: "${ACCURACY_TOKENIZER_PATH:=${ACCURACY_MODEL_PATH}}"
: "${ACCURACY_TOKENIZER_MODE:=deepseek_v4}"
: "${ACCURACY_QUANTIZATION:=ascend}"
: "${ACCURACY_PIPELINE_PARALLEL_SIZE:=2}"
: "${ACCURACY_TENSOR_PARALLEL_SIZE:=4}"
: "${ACCURACY_SAFETENSORS_LOAD_STRATEGY:=auto}"

export ACCURACY_MODEL_ID ACCURACY_MODEL_PATH ACCURACY_FALLBACK_MODEL_PATH
export ACCURACY_SERVED_MODEL_NAME ACCURACY_TOKENIZER_PATH
export ACCURACY_TOKENIZER_MODE ACCURACY_QUANTIZATION
export ACCURACY_PIPELINE_PARALLEL_SIZE ACCURACY_TENSOR_PARALLEL_SIZE
export ACCURACY_SAFETENSORS_LOAD_STRATEGY
