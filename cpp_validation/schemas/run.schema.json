{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPP validation run metadata",
  "type": "object",
  "required": ["schema_version", "run_id", "suite", "started_at", "host", "model_path", "npu_devices"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "run_id": {"type": "string", "minLength": 1},
    "base_run_id": {"type": "string", "minLength": 1},
    "suite": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "host": {"type": "string", "minLength": 1},
    "model_path": {"type": "string", "minLength": 1},
    "npu_devices": {"type": "array", "minItems": 2, "items": {"type": "integer"}},
    "model_id": {"type": "string", "minLength": 1},
    "model_family": {"type": "string"},
    "tokenizer": {"type": "object"},
    "quantization": {"type": ["string", "null"]},
    "gpu_memory_utilization": {"type": "number"},
    "kv_cache_memory": {"type": ["string", "null"]},
    "expert_parallel": {"type": "boolean"},
    "safetensors_load_strategy": {"type": "string"}
  }
}
